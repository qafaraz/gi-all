# CakePHP
# website: https://cakephp.org
# docs: https://book.cakephp.org
# description: CakePHP rapid development PHP framework temporary files, cache, logs, and sensitive configurations

# CakePHP 3.x, 4.x & 5.x application runtime
/tmp/*
!/tmp/cache/models/empty
!/tmp/cache/persistent/empty
!/tmp/cache/views/empty
!/tmp/sessions/empty
!/tmp/tests/empty
!/tmp/**/.gitkeep
/logs/*
!/logs/empty
!/logs/.gitkeep

# CakePHP sensitive and local configuration
/config/app_local.php
/config/app.php
/config/.env

# CakePHP 2.x legacy application runtime
/app/tmp/*
!/app/tmp/cache
!/app/tmp/logs
!/app/tmp/sessions
!/app/tmp/tests
/app/tmp/cache/models/*
!/app/tmp/cache/models/empty
/app/tmp/cache/persistent/*
!/app/tmp/cache/persistent/empty
/app/tmp/cache/views/*
!/app/tmp/cache/views/empty
/app/tmp/sessions/*
!/app/tmp/sessions/empty
/app/tmp/tests/*
!/app/tmp/tests/empty
/app/tmp/logs/*
!/app/tmp/logs/empty

# CakePHP 2.x legacy configuration
/app/Config/core.php
/app/Config/database.php
/app/Config/email.php

# Dependency directories
/vendor/*
/vendors/*