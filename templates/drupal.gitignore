# Drupal
# website: https://www.drupal.org
# docs: https://www.drupal.org/docs
# description: Drupal site configuration, user uploads, temporary caches, and Composer-managed contrib dependencies

# Sensitive configuration files and local development services
sites/*/*settings*.php
!sites/*/default.settings.php
sites/*/*services*.yml
!sites/*/default.services.yml
sites/development.services.yml
sites/example.settings.local.php
sites/example.sites.php
web/sites/*/*settings*.php
!web/sites/*/default.settings.php
web/sites/*/*services*.yml
!web/sites/*/default.services.yml
web/sites/development.services.yml
web/sites/example.settings.local.php
web/sites/example.sites.php

# User-generated content and media files
sites/*/files/
sites/*/public/
sites/*/private/
sites/*/files-public/
sites/*/files-private/
web/sites/*/files/
web/sites/*/public/
web/sites/*/private/
web/sites/*/files-public/
web/sites/*/files-private/
private/

# Temporary files, caches, and translations
sites/*/translations/
sites/*/tmp/
sites/*/cache/
web/sites/*/translations/
web/sites/*/tmp/
web/sites/*/cache/

# Composer dependencies, Drupal core, and contributed extensions
/vendor/
core/
web/core/
modules/contrib/
web/modules/contrib/
themes/contrib/
web/themes/contrib/
profiles/contrib/
web/profiles/contrib/
libraries/
web/libraries/

# Drupal core scaffold files (drupal/core-composer-scaffold)
web/.htaccess
web/robots.txt
web/index.php
web/update.php
web/autoload.php
web/web.config
web/.ht.router.php
web/example.gitignore
web/INSTALL.txt
web/LICENSE.txt
web/README.txt
web/modules/README.txt
web/profiles/README.txt
web/themes/README.txt
web/sites/README.txt
web/.editorconfig
web/.gitattributes
web/.eslintignore
web/.eslintrc.json
web/.csslintrc

# SimpleTest environment and CLI binaries
sites/simpletest/
web/sites/simpletest/
drush/contrib/
composer.phar
drush.phar
drupal.phar
robo.phar
/drush
/drupal
/robo
/composer