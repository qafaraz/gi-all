# Node.js
# website: https://nodejs.org
# docs: https://nodejs.org/docs/latest/api/
# description: Node.js runtime environment, npm package management, build artifacts, and crash reports.

# Logs
logs
*.log
yarn-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Node.js diagnostic crash reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime process and state data
pids
*.pid
*.seed
*.pid.lock

# Test coverage and instrumented libraries
lib-cov
coverage/
*.lcov
.nyc_output

# Compiled binary addons
build/Release
.lock-wscript

# Dependency directories
jspm_packages/
web_modules/

# TypeScript, bundler, and compiler caches
*.tsbuildinfo
.cache/
.parcel-cache

# Linter and formatter caches
.eslintcache
.stylelintcache

# Package manager caches, local stores, and tarballs
.npm
.pnpm-store
.node_repl_history
*.tgz
.yarn-integrity

# NitroJS server engine
.nitro/
.output