# Microsoft Dynamics 365 Business Central (AL)
# website: https://dynamics.microsoft.com/business-central/overview/
# docs: https://learn.microsoft.com/dynamics365/business-central/dev-itpro/developer/devenv-dev-overview
# description: Recommended gitignore rules for Microsoft Dynamics 365 Business Central AL development.

# Symbols and compiler caches
.alcache/
.alpackages/

# Build artifacts and extension packages
*.app
.output/

# Snapshots and rapid application development
.snapshots/
rad.json

# Auto-generated translation files
*.g.xlf

# License files
*.bclicense
*.flf

# Test outputs and runner
TestResults.xml
.altestrunner/