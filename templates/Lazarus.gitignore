# Lazarus (Free Pascal IDE)
# website: https://www.lazarus-ide.org
# docs: https://wiki.freepascal.org/Lazarus_Documentation
# description: Lazarus IDE and Free Pascal compiler outputs, project session state, and binaries

# Compiler-generated binaries
*.exe
*.dll
*.so
*.dylib
*.lrs
*.res
*.compiled
*.dbg
*.ppu
*.ppl
*.o
*.or
*.a

# Autogenerated resource and string files
*.rst
*.rsj
*.lrt

# Local user-specific session files (breakpoints, windows state)
*.lps

# Backups and unit output folders
backup/
*.bak
lib/

# macOS application bundle
*.app/