# Django
# website: https://www.djangoproject.com
# docs: https://docs.djangoproject.com
# description: Django web framework local settings, development databases, collected static files, and media uploads

# Local settings and environment overrides
local_settings.py

# Default local SQLite database files
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm

# User-uploaded media files
media/
media_root/

# Collected static assets (STATIC_ROOT)
staticfiles/
static_root/
static_collected/

# File-based cache and session storage
*.session

# Celery task runner schedules (frequently used with Django)
celerybeat-schedule*
celerybeat.pid

# Python byte-compiled cache
__pycache__/
*.py[cod]
*$py.class