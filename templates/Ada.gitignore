# gitignore template for Ada
# website: https://ada-lang.io
# docs: https://learn.adacore.com
# description: Ada programming language, GNAT compiler artifacts, and Alire package manager

# Object files and Ada Library Information (GNAT)
*.o
*.ali

# GNAT binder generated files
b~*.ad[bs]
b_*.ad[bs]

# GPRbuild and build output directories
obj/
lib/
bin/

# Alire package manager
alire/cache/
alire/build/

# GNAT Studio IDE
.gnat_studio/