# gitignore template for ActionScript
# website: https://adobe.com
# docs: https://helpx.adobe.com/animate/using/actionscript.html
# description: ActionScript, Adobe Flash, Flex, and AIR build artifacts and binaries

# Build and release directories
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Flash Builder and Eclipse settings
.settings/

# Compiled executables and packages
*.swf
*.air
*.ipa
*.apk

# Note: Project files (.project, .actionScriptProperties, .flexProperties)
# should NOT be excluded as they contain compiler settings for Eclipse / Flash Builder.