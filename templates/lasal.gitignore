# LASAL
# website: https://www.sigmatek-automation.com/en/products/software/lasal-tools/
# docs: https://www.sigmatek-automation.com/en/products/software/lasal-tools/lasal-class/
# description: SIGMATEK LASAL engineering suite build outputs, runtime folders, and compiler artifacts

# LASAL SCREEN and VISU runtime folders generated during build
**/Runtime
**/BAK
**/Language
**/TempPreview

# LASAL CLASS runtime folders generated during build
ProjectInternal
Internal
**/Network/*/*.st
**/Drive/*.st

# Bootdisk files
**/Bootdisk

# Various filetypes generated at runtime or used for internal backups
*.ldi
*.bak
*.lob
*.lba
*.lcb
*.lock
*.plc
*.7z
*.zip
*.lcc
*.lds

# Tag files generated by the compiler
*.mme
**/MaeExp.txt
**/MaeExp.xml

# SigCLib requires lba and lob files
!cObjLib.lob
!cObjLib.lba

# OPC related classes added automatically from LASAL instance
!**/Class/OPC_UA/**
!**/Class/OPC_UA_Client/**
!**/Class/OPC_UA_Server/**
!**/Class/OPC_UA_ModuleBase/**
!**/Class/OPC_UA_AddressSpace/**
!**/Class/OPC_UA_OpenSSL_v1_1_1/**