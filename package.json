{
  "name": "gi-all",
  "version": "2.0.7",
  "type": "module",
  "description": "The only modular, category-based .gitignore generator you'll ever need.",
  "homepage": "https://qafaraz.github.io/gi-all",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qafaraz/gi-all.git"
  },
  "bugs": {
    "url": "https://github.com/qafaraz/gi-all/issues"
  },
  "author": {
    "name": "Qafar",
    "url": "https://github.com/qafaraz"
  },
  "license": "MIT",
  "bin": {
    "gi-all": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node src/cli.js",
    "test": "node --test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build:templates": "node scripts/build-templates-data.js",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "keywords": [
    "gitignore",
    "git",
    "ignore",
    "template",
    "templates",
    "modular",
    "category-based",
    "cli",
    "gitignore-template",
    "gitignore-generator",
    "developer-tools",
    "gi-all"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "conventional-commits-filter": "^6.0.1",
    "husky": "^9.1.7",
    "release-it": "^20.2.1"
  },
  "overrides": {
    "undici": "^6.26.1",
    "lodash": "^4.17.21",
    "@conventional-changelog/git-client": "^3.1.0",
    "brace-expansion": "^2.0.1"
  }
}
