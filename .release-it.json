{
  "$schema": "https://unpkg.com/release-it@latest/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "commitMessage": "chore(release): v${version} [skip ci]",
    "tagName": "v${version}",
    "push": false,
    "requireCleanWorkingDir": false
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "web": false
  },
  "npm": {
    "publish": true,
    "publishArgs": ["--provenance"]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "conventionalcommits",
      "infile": "CHANGELOG.md"
    }
  }
}
